    { "name": "trabajadores_matriz", "label": "Trabajadores centro matriz", "type": "number" },
    { "name": "direccion_sucursal_1", "label": "Dirección sucursal 1 (si aplica)", "type": "text" },
    { "name": "trabajadores_sucursal_1", "label": "Trabajadores sucursal 1", "type": "number" },
    { "name": "direccion_sucursal_2", "label": "Dirección sucursal 2 (si aplica)", "type": "text" },
    { "name": "trabajadores_sucursal_2", "label": "Trabajadores sucursal 2", "type": "number" }
