    { "name": "representante_legal", "label": "Representante legal", "type": "text", "required": true },
    { "name": "representante_legal_cedula", "label": "Cédula del representante legal", "type": "text" },

    { "name": "responsable_sst", "label": "Responsable SST (Técnico/Proveedor)", "type": "text", "required": true },
