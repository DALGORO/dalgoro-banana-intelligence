    { "name": "codigo_ciiu", "label": "CIIU (opcional)", "type": "text" },

    { "name": "descripcion_ciiu", "label": "Actividad CIIU (opcional)", "type": "text" },

    { "name": "actividad", "label": "Actividad (autollenado)", "type": "text", "required": true },
    { "name": "trabajadores", "label": "Número de trabajadores (autollenado)", "type": "number", "required": true },
    { "name": "riesgo", "label": "Nivel de riesgo (autollenado)", "type": "text", "required": true },
