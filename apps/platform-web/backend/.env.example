# Conexión heredada: se conserva para los módulos existentes y no la usa DBI.
DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/dalgoro_banana

# Conexión DBI: use credenciales distintas por proceso y ambiente.
DBI_ENVIRONMENT=development
DBI_DATABASE_URL=postgresql+psycopg://dbi_migrator:REEMPLAZAR_EN_ENTORNO_SEGURO@localhost:5432/dbi_development

JWT_SECRET=REEMPLAZAR_EN_ENTORNO_SEGURO
GCS_BUCKET=
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=USD
WEBHOOK_SECRET=REEMPLAZAR_EN_ENTORNO_SEGURO
GCS_CREDENTIALS_JSON=
GCS_SIGNED_URL_EXPIRATION_HOURS=1
ENABLE_DOCS=false
